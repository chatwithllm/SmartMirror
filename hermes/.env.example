# Hermes environment — NAMES ONLY. Copy to .env and fill in real values.
# .env is git-ignored. Never commit real secrets.

# --- Postgres (Processor + Web) ---
DATABASE_URL=postgres://hermes:CHANGE_ME@postgres:5432/hermes

# --- MQTT bus (Collector + Processor) ---
# Point at your existing Mosquitto broker; Hermes only provisions the hermes/* namespace.
MQTT_URL=mqtt://mosquitto:1883
# Optional broker auth
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Home Assistant (Collector telemetry source) ---
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# --- Telegram (Collector channel adapter) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to talk to the bot (empty = allow all, dev only)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Web / API ---
# Header the authenticating reverse proxy sets with the trusted identity.
PROXY_IDENTITY_HEADER=x-hermes-user
# Auth.js v5 secret (generate with `openssl rand -base64 32`)
AUTH_SECRET=
WEB_PORT=3000

# --- Processor tuning ---
# Correlation look-back window in seconds.
CORRELATION_WINDOW=300
# Minimum severity that gets routed back out to egress (info|warn|error|crit).
ROUTE_THRESHOLD=warn

# --- Collector ---
# Where the disk buffer spools envelopes when the broker is down.
COLLECTOR_BUFFER_DIR=/data/collector-buffer
COLLECTOR_HEALTH_PORT=8081
PROCESSOR_HEALTH_PORT=8082
